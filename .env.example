# Modelo de configuração. Copie para .env e preencha:
#
#     cp .env.example .env
#
# O .env é gitignored e nunca deve ser commitado. Os valores abaixo são
# exemplos de desenvolvimento — nenhum serve para produção.
#
# Antes de subir para produção, leia docs/PRODUCAO.md: SECRET_KEY,
# POSTGRES_PASSWORD, REDIS_PASSWORD e ADMIN_PASSWORD precisam de valores
# próprios, e ADMIN_PASSWORD precisa ser um hash bcrypt (ver adiante).

# --- Aplicação ---------------------------------------------------------

APP_NAME=SEMPRE TRICOLOR

# development | staging | production
# Fora de "development" a aplicação recusa subir com ADMIN_PASSWORD em
# texto puro (ver app/core/config.py).
APP_ENV=development

# Precisa ser true para OTP_PROVIDER=mock funcionar — o provider mock
# escreve o código OTP no log e se recusa a rodar fora de modo debug.
# Sempre false em produção.
DEBUG=true

# Chave de assinatura dos tokens. Gere uma própria:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# Separadas por vírgula. Em produção, o domínio real do site.
ALLOWED_ORIGINS=http://localhost:8000

# --- Banco de dados ----------------------------------------------------

# Consumidas pelo serviço "db" do docker-compose.yml, que falha ao subir se
# POSTGRES_USER ou POSTGRES_PASSWORD estiverem vazias.
POSTGRES_USER=sondagem
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=sondagem_clube

# O host é "db" (nome do serviço na rede interna do compose) quando a
# aplicação roda em container. Rodando uvicorn direto no host, troque os
# dois "db" por "localhost".
#
# São duas URLs para o mesmo banco de propósito: a aplicação usa o driver
# async (asyncpg) e o Alembic usa o síncrono (psycopg2).
DATABASE_URL=postgresql+asyncpg://sondagem:troque-esta-senha@db:5432/sondagem_clube
DATABASE_URL_SYNC=postgresql+psycopg2://sondagem:troque-esta-senha@db:5432/sondagem_clube

# --- Redis -------------------------------------------------------------

# Guarda as sessões de cadastro e os códigos OTP. REDIS_PASSWORD é
# consumida pelo serviço "redis" do compose e precisa bater com a senha
# embutida na REDIS_URL abaixo.
REDIS_PASSWORD=troque-esta-senha
REDIS_URL=redis://:troque-esta-senha@redis:6379/0

# --- OTP ---------------------------------------------------------------

# twilio | zenvia | zapi | mock
# "mock" não envia SMS: escreve o código no log da aplicação, para testar o
# fluxo localmente sem contratar provedor. Exige DEBUG=true.
OTP_PROVIDER=mock

OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Preencha só o bloco do provider escolhido em OTP_PROVIDER.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

ZENVIA_API_TOKEN=
ZENVIA_FROM=

ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# --- reCAPTCHA v3 ------------------------------------------------------

# Vazias desativam a verificação — aceitável em desenvolvimento, não em
# produção.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_MIN_SCORE=0.5

# --- Webhook (n8n) -----------------------------------------------------

# Destino do POST com cada voto registrado. Vazia desativa o envio (os
# registros ficam pendentes e são reprocessados quando a URL for
# configurada). Detalhes da configuração do node no n8n: docs/WEBHOOK.md.
WEBHOOK_URL=

# Enviado como "Authorization: Bearer <token>". Sem ele, quem descobrir a
# URL recebe nome, CPF e telefone dos votantes.
WEBHOOK_TOKEN=

WEBHOOK_RETRY_MAX=5
WEBHOOK_RETRY_DELAY_SECONDS=60

# --- Painel administrativo ---------------------------------------------

ADMIN_USERNAME=admin

# Em desenvolvimento pode ser texto puro. Fora de APP_ENV=development
# precisa ser um hash bcrypt, senão a aplicação recusa subir. Gere com:
#     python scripts/hash_password.py "sua-senha"
ADMIN_PASSWORD=admin123

ADMIN_JWT_EXPIRE_MINUTES=480

# --- Rate limiting -----------------------------------------------------

# Valores de produção. Afrouxe apenas para teste de carga
# (ver docs/TESTE_DE_CARGA.md).
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_OTP=10/minute
RATE_LIMIT_ADMIN_LOGIN=5/minute
RATE_LIMIT_VALIDATE_CPF=30/minute
RATE_LIMIT_REGISTER=10/minute
RATE_LIMIT_VERIFY_OTP=15/minute
RATE_LIMIT_RESEND_OTP=5/minute
RATE_LIMIT_SUBMIT=10/minute

# --- Segurança de transporte -------------------------------------------

# true em produção (exige HTTPS nos cookies). Deixe false em
# desenvolvimento, senão o login do admin não funciona em http://localhost.
HTTPS_ONLY=false

# true apenas se a aplicação estiver atrás de um proxy reverso confiável
# (nginx, Cloudflare). Com true sem proxy na frente, o rate limit por IP
# passa a confiar em cabeçalhos que o cliente controla.
TRUST_PROXY_HEADERS=false

# --- Upload de fotos dos candidatos ------------------------------------

UPLOAD_DIR=uploads/candidatos
MAX_UPLOAD_SIZE_MB=5
